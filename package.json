		"@tiptap/starter-kit": "^3.32.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tiptap-markdown": "^0.9.0"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@tauri-apps/cli": "^2",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^6.0.2",
		"eslint": "^10.12.0",
