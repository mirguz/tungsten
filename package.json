{
	"name": "tungsten",
	"private": false,
	"packageManager": "pnpm@10.34.5",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"format": "prettier --write .",
