---
import { getCollection, render } from "astro:content";

interface Props {
	slug: string;
}

const { slug } = Astro.props;
const docs = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const entry = docs.find((d) => d.id === slug)!;
const { Content } = await render(entry);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title>{entry.data.title} — Tungsten</title>
		<style>
			:root {
				--bg: #1e1e1e;
				--bg-sidebar: #181818;
				--bg-hover: #2a2a2a;
				--text: #dcddde;
				--text-muted: #8a8a8a;
				--border: #2e2e2e;
				--accent: #9b7df5;
			}
			@media (prefers-color-scheme: light) {
				:root {
					--bg: #ffffff;
					--bg-sidebar: #f5f5f5;
					--bg-hover: #ebebeb;
					--text: #2e2e2e;
					--text-muted: #6b6b6b;
					--border: #e0e0e0;
					--accent: #7c3aed;
				}
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				display: flex;
				min-height: 100vh;
				background: var(--bg);
				color: var(--text);
				font-family: -apple-system, system-ui, "Segoe UI", Roboto, sans-serif;
			}
			nav {
				width: 230px;
				flex-shrink: 0;
				background: var(--bg-sidebar);
				border-right: 1px solid var(--border);
				padding: 20px 12px;
			}
			nav h1 {
				font-size: 1.1rem;
				margin: 4px 8px 16px;
				color: var(--accent);
			}
			nav a {
				display: block;
				padding: 6px 8px;
				border-radius: 6px;
				color: var(--text);
				text-decoration: none;
				font-size: 0.92rem;
			}
			nav a:hover {
				background: var(--bg-hover);
			}
			nav a[aria-current="page"] {
				background: var(--bg-hover);
				color: var(--accent);
				font-weight: 600;
			}
			main {
				flex: 1;
				max-width: 720px;
				padding: 40px 48px;
				line-height: 1.65;
			}
			main :global(h1) {
				margin-top: 0;
			}
			main :global(h2) {
				margin-top: 2em;
				border-bottom: 1px solid var(--border);
				padding-bottom: 0.3em;
			}
			main :global(code) {
				background: var(--bg-hover);
				padding: 2px 5px;
				border-radius: 4px;
				font-size: 0.9em;
			}
			main :global(pre) {
				background: var(--bg-hover);
				padding: 14px 16px;
				border-radius: 8px;
				overflow-x: auto;
			}
			main :global(pre code) {
				background: none;
				padding: 0;
			}
			main :global(a) {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<nav>
			<h1>Tungsten</h1>
			{
				docs.map((d) => (
					<a href={`/docs/${d.id}/`} aria-current={d.id === slug ? "page" : undefined}>
						{d.data.title}
					</a>
				))
			}
		</nav>
		<main>
			<h1>{entry.data.title}</h1>
			<Content />
		</main>
	</body>
</html>
